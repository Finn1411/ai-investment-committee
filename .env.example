# Environment Variables Template
# Copy this to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database (optional — defaults to SQLite in project root) ──────────────────
# DATABASE_URL=sqlite:///./finance_agent.db
# DATABASE_URL=postgresql://user:password@localhost:5432/finance_agent

# ── Optional: Financial Data APIs ─────────────────────────────────────────────
# ALPHA_VANTAGE_API_KEY=your_key_here
# FINANCIAL_MODELING_PREP_API_KEY=your_key_here
